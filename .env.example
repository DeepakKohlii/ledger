# Root reference for all environment variables used by this project.
# Copy the relevant sections into backend/.env and frontend/.env.
# See backend/.env.example and frontend/.env.example for per-service files.

# ---------- Backend ----------
# Neon Postgres connection string (use the pooled endpoint in production)
DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/dbname?sslmode=require

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of Groq API keys. The backend rotates across them
# and cools down individual keys that return 429.
GROQ_API_KEYS=gsk_key_one,gsk_key_two
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173

# ---------- Frontend ----------
# Base path for API calls. Left as a relative path in production so that the
# Vercel rewrite proxies requests to the backend from the same origin.
VITE_API_BASE_URL=/api
