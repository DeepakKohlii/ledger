# Neon Postgres connection string. Use the pooled endpoint in production.
DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/dbname?sslmode=require

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated Groq API keys. The backend rotates across them and cools
# down any individual key that returns 429.
GROQ_API_KEYS=gsk_key_one,gsk_key_two
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173

# "development" or "production". Controls cookie flags and docs exposure.
ENVIRONMENT=development
