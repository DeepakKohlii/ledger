# Base path for API requests. Kept relative so the platform rewrite
# (production) and the Vite dev proxy (local) both serve the API from this
# origin, which keeps the auth cookie first-party.
VITE_API_BASE_URL=/api

# Where the dev proxy forwards /api during local development.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
